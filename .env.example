# Copy this file to .env and paste your own key. Never commit .env.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: pin a Jev version instead of always using the newest.
# JEV_MODEL=typesafe/jev-1.13

# Optional (recipe 14): the small model that writes text into form fields.
# TEXT_MODEL=inception/mercury-2.5

# Optional (recipe 14): use an installed Chrome instead of `npx playwright install chromium`.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
